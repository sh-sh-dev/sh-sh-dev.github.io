---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../data/site';

const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Notes" description="Draft notes and experiments by Shaygan Shokrollahi on AI, product, and backend systems.">
  <section class="border-b border-border">
    <div class="site-container py-16 md:py-24">
      <p class="label-meta mb-4" data-animate="section">Notes</p>
      <h1 class="display-section max-w-3xl" data-animate="section">Notes & experiments</h1>
      <p class="body-lg mt-6 max-w-2xl" data-animate="section">
        Things I’m learning, building, and thinking about. These are draft topics—not published articles.
      </p>
    </div>
  </section>

  <section class="border-b border-border">
    <div class="site-container py-16 md:py-20">
      <ul class="divide-y divide-border border-y border-border">
        {
          notes.map((note) => (
            <li data-animate="section">
              <a
                href={withBase(`/notes/${note.id}`)}
                class="group grid gap-3 py-8 md:grid-cols-[7rem_1fr] md:items-start md:gap-10"
              >
                <span class="label-meta pt-1">Draft</span>
                <div>
                  <h2 class="text-2xl font-semibold tracking-tight transition-colors group-hover:text-ink md:text-3xl">
                    {note.data.title}
                  </h2>
                  <p class="mt-3 max-w-2xl text-sm text-muted md:text-base">{note.data.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
