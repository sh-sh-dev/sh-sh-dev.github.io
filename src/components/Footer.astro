---
import { site, withBase } from '../data/site';

const year = 2026;
---

<section class="pb-4" aria-labelledby="footer-cta-heading">
  <div class="site-container py-14 md:py-20" data-animate="section">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
      <h2 id="footer-cta-heading" class="display-section max-w-xl">
        Got a vision? Let’s bring it to life.
      </h2>
      <a href={withBase('/contact')} class="btn">Contact me</a>
    </div>
  </div>
</section>

<footer class="bg-dark text-white">
  <div class="site-container py-12 md:py-16">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-lg font-semibold tracking-tight">{site.name}</p>
        <p class="mt-2 max-w-sm text-sm text-white/55">{site.title}</p>
        <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/65" aria-label="Footer">
          {
            site.nav.map((item) => (
              <a href={withBase(item.href)} class="transition hover:text-white">
                {item.label}
              </a>
            ))
          }
          <a href={site.social.github} class="transition hover:text-white" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
          <a href={site.social.linkedin} class="transition hover:text-white" target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        </nav>
        <p class="mt-8 text-sm text-white/40">© {year} {site.name}</p>
      </div>

      <a
        href={`mailto:${site.email}`}
        class="break-all text-3xl font-semibold tracking-tight text-white md:text-5xl lg:text-right lg:text-6xl"
      >
        {site.email === 'REPLACE_EMAIL' ? 'hello@example.com' : site.email}
      </a>
    </div>
  </div>
</footer>
