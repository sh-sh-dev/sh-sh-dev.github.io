---
interface Props {
  title: string;
  description: string;
  index: number;
  tone?: 'sand' | 'stone' | 'sage' | 'ink';
}

const { title, description, index, tone = 'sand' } = Astro.props;
const padded = String(index + 1).padStart(2, '0');
---

<article
  class="capability-card group overflow-hidden rounded-[1.25rem] border border-border bg-white"
  data-animate="section"
>
  <div class:list={['relative aspect-square overflow-hidden', `capability-tone-${tone}`]}>
    <div class="absolute inset-0 opacity-30">
      <svg class="h-full w-full" viewBox="0 0 400 400" aria-hidden="true">
        <circle cx="200" cy="180" r="90" fill="none" stroke="currentColor" stroke-width="1" />
        <rect x="70" y="70" width="180" height="220" fill="none" stroke="currentColor" stroke-width="1" />
        <path d="M40 320 H360" stroke="currentColor" stroke-width="1" />
      </svg>
    </div>
    <div class="absolute bottom-4 right-4 flex h-11 w-11 items-center justify-center rounded-full bg-ink text-white transition group-hover:scale-105">
      <span class="sr-only">Capability</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </div>
    <p class="absolute left-5 top-5 text-xs font-medium tracking-[0.14em] uppercase opacity-70">
      {padded}
    </p>
  </div>
  <div class="p-6 md:p-7">
    <h3 class="text-xl font-semibold tracking-tight md:text-2xl">{title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-muted md:text-base">{description}</p>
  </div>
</article>
