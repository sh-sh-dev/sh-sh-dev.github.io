---
import { site } from '../data/site';
import HeroVisual from './HeroVisual.astro';
---

<section class="relative overflow-hidden border-b border-border" aria-labelledby="hero-heading">
  <div class="site-container py-10 sm:py-12 md:py-20 lg:py-24">
    <!--
      Mobile/tablet: compact square portrait beside the intro.
      Desktop: editorial two-column layout with large portrait.
    -->
    <div class="flex items-start gap-4 sm:gap-6 lg:grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-end lg:gap-16">
      <div class="min-w-0 flex-1">
        <p class="label-meta mb-4 sm:mb-6" data-animate="hero-line">Software Engineer</p>

        <h1 id="hero-heading" class="display-hero">
          <span class="block text-muted" data-animate="hero-line">Hello. </span>
            <span class="block" data-animate="hero-line"><span class="text-muted">I’m</span> Shaygan Shokrollahi.</span>
        </h1>

        <p class="body-lg mt-6 max-w-xl sm:mt-8" data-animate="hero-line">
          I build products, systems, and businesses.
        </p>
      </div>

      <div class="w-24 shrink-0 sm:w-32 md:w-40 lg:w-full lg:max-w-none">
        <HeroVisual />
      </div>
    </div>

    <div
      class="mt-10 grid gap-5 border-t border-border pt-8 sm:mt-14 sm:grid-cols-3 sm:gap-6 sm:pt-10 md:mt-16"
      data-animate="section"
    >
      {
        site.metrics.map((metric) => (
          <div>
            <p class="text-xl font-semibold tracking-tight sm:text-2xl md:text-3xl">{metric.value}</p>
            <p class="mt-1.5 text-sm text-muted sm:mt-2">{metric.label}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-10 flex items-center gap-3 text-sm text-muted sm:mt-14" data-animate="hero-line">
      <span class="inline-block h-8 w-px bg-border" aria-hidden="true"></span>
      Scroll to explore
    </p>
  </div>
</section>
